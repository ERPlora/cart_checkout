{
  "id": "cart_checkout",
  "name": "Cart & Checkout",
  "version": "1.0.15",
  "description": "Shopping cart and checkout flow: add items, run checkout and turn carts into paid orders.",
  "agent": {
    "description": "Manages shopping carts and the checkout process: add/remove items, initiate checkout, create orders, and mark payments.",
    "keywords": [
      "cart",
      "checkout",
      "order",
      "purchase",
      "basket",
      "payment",
      "ecommerce"
    ]
  },
  "depends_on": [],
  "permissions": [
    "cart_checkout.view_cart",
    "cart_checkout.manage_cart",
    "cart_checkout.checkout"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "cart_checkout.view_cart",
      "cart_checkout.manage_cart",
      "cart_checkout.checkout"
    ],
    "employee": [
      "cart_checkout.view_cart"
    ]
  },
  "navigation": [
    {
      "id": "carts",
      "label": "Carts",
      "icon": "bag-check-outline",
      "component": "erp-cart-checkout-carts"
    },
    {
      "id": "orders",
      "label": "Orders",
      "icon": "receipt-outline",
      "component": "erp-cart-checkout-orders"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_order_counter.sql",
      "migrations/postgres/003_quantity_fixed_point.sql"
    ]
  },
  "queries": {
    "cart_checkout.carts.list": {
      "permission": "cart_checkout.view_cart",
      "sql": "queries/carts_list.sql",
      "list": {
        "search": [
          "customer_email",
          "customer_name"
        ],
        "sort": [
          "id",
          "session_token",
          "customer_email",
          "customer_name",
          "status",
          "total_items",
          "total_amount",
          "currency",
          "expires_at",
          "last_activity_at",
          "notes",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "session_token": {
            "op": "eq"
          },
          "customer_email": {
            "op": "like"
          },
          "customer_name": {
            "op": "like"
          },
          "status": {
            "op": "eq"
          },
          "total_items": {
            "op": "range"
          },
          "total_amount": {
            "op": "range"
          },
          "currency": {
            "op": "eq"
          },
          "expires_at": {
            "op": "range"
          },
          "last_activity_at": {
            "op": "range"
          },
          "notes": {
            "op": "like"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists active or recent shopping carts"
      }
    },
    "cart_checkout.carts.get": {
      "permission": "cart_checkout.view_cart",
      "sql": "queries/cart_get.sql",
      "ai": {
        "description": "Retrieves the full detail of a specific shopping cart including its items"
      }
    },
    "cart_checkout.items.list": {
      "permission": "cart_checkout.view_cart",
      "sql": "queries/items_list.sql",
      "list": {
        "search": [
          "product_ref",
          "product_name",
          "sku"
        ],
        "sort": [
          "id",
          "cart_id",
          "product_ref",
          "product_name",
          "sku",
          "quantity",
          "unit_price",
          "line_total",
          "variant_attributes"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "cart_id": {
            "op": "eq"
          },
          "product_ref": {
            "op": "eq"
          },
          "product_name": {
            "op": "like"
          },
          "sku": {
            "op": "like"
          },
          "quantity": {
            "op": "range"
          },
          "unit_price": {
            "op": "range"
          },
          "line_total": {
            "op": "range"
          },
          "variant_attributes": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists items added to a shopping cart"
      }
    },
    "cart_checkout.items.get": {
      "permission": "cart_checkout.view_cart",
      "sql": "queries/item_get.sql"
    },
    "cart_checkout.orders.list": {
      "permission": "cart_checkout.view_cart",
      "sql": "queries/orders_list.sql",
      "list": {
        "search": [
          "order_number",
          "customer_email"
        ],
        "sort": [
          "id",
          "cart_id",
          "order_number",
          "customer_email",
          "shipping_method",
          "payment_method",
          "status",
          "placed_at",
          "paid_at",
          "completed_at",
          "total_amount",
          "notes",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "cart_id": {
            "op": "eq"
          },
          "order_number": {
            "op": "eq"
          },
          "customer_email": {
            "op": "like"
          },
          "shipping_method": {
            "op": "eq"
          },
          "payment_method": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "placed_at": {
            "op": "range"
          },
          "paid_at": {
            "op": "range"
          },
          "completed_at": {
            "op": "range"
          },
          "total_amount": {
            "op": "range"
          },
          "notes": {
            "op": "like"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists orders generated from the checkout process"
      }
    },
    "cart_checkout.orders.get": {
      "permission": "cart_checkout.view_cart",
      "sql": "queries/order_get.sql",
      "ai": {
        "description": "Retrieves the full detail of a specific order including its payment status"
      }
    }
  },
  "commands": {
    "cart_checkout.carts.create": {
      "permission": "cart_checkout.manage_cart",
      "transaction": true,
      "sql": [
        "commands/cart_create.sql"
      ],
      "schema": "schemas/cart_create.json",
      "emit": [
        "cart_checkout.cart.created"
      ],
      "ai": {
        "description": "Creates a new shopping cart for a customer or session"
      }
    },
    "cart_checkout.carts.mark_abandoned": {
      "permission": "cart_checkout.manage_cart",
      "transaction": true,
      "sql": [
        "commands/cart_mark_abandoned.sql"
      ],
      "schema": "schemas/cart_mark_abandoned.json",
      "emit": [
        "cart_checkout.cart.abandoned"
      ],
      "ai": {
        "description": "Marks a cart as abandoned when the customer did not complete the purchase"
      }
    },
    "cart_checkout.carts.delete": {
      "permission": "cart_checkout.manage_cart",
      "transaction": true,
      "sql": [
        "commands/cart_delete.sql"
      ],
      "schema": "schemas/cart_delete.json",
      "emit": [
        "cart_checkout.cart.deleted"
      ],
      "ai": {
        "description": "Permanently deletes a shopping cart and all its items (destructive)"
      }
    },
    "cart_checkout.items.remove": {
      "permission": "cart_checkout.manage_cart",
      "transaction": true,
      "sql": [
        "commands/item_remove.sql",
        "commands/_recalc_totals_by_item.sql"
      ],
      "schema": "schemas/item_remove.json",
      "emit": [
        "cart_checkout.item.removed"
      ],
      "ai": {
        "description": "Removes a specific item from the shopping cart"
      }
    },
    "cart_checkout.orders.mark_paid": {
      "permission": "cart_checkout.checkout",
      "transaction": true,
      "sql": [
        "commands/order_mark_paid.sql"
      ],
      "schema": "schemas/order_mark_paid.json",
      "emit": [
        "cart_checkout.order.paid"
      ],
      "ai": {
        "description": "Marks an order as paid after confirming the payment"
      }
    },
    "cart_checkout.orders.fail": {
      "permission": "cart_checkout.checkout",
      "transaction": true,
      "sql": [
        "commands/order_fail.sql"
      ],
      "schema": "schemas/order_fail.json",
      "emit": [
        "cart_checkout.order.failed"
      ],
      "ai": {
        "description": "Records an order as failed, indicating the reason for the payment error"
      }
    },
    "cart_checkout.items.add": {
      "permission": "cart_checkout.manage_cart",
      "schema": "schemas/item_add.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_to_cart"
      },
      "ai": {
        "description": "Adds a product to the shopping cart with the specified quantity (the handler emits cart_checkout.item.added)"
      }
    },
    "cart_checkout.items.update": {
      "permission": "cart_checkout.manage_cart",
      "schema": "schemas/item_update.json",
      "reads": [
        {
          "query": "cart_checkout.items.get",
          "params": {
            "item_id": "payload.item_id"
          }
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_cart_item"
      },
      "ai": {
        "description": "Updates the quantity of an item already in the cart; quantity <= 0 removes it (the handler emits cart_checkout.item.updated)"
      }
    },
    "cart_checkout.carts.clear": {
      "permission": "cart_checkout.manage_cart",
      "schema": "schemas/cart_clear.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "clear_cart"
      },
      "ai": {
        "description": "Clears all items from a shopping cart, leaving it empty (the handler emits cart_checkout.cart.cleared)"
      }
    },
    "cart_checkout.carts.cleanup_expired": {
      "permission": "cart_checkout.manage_cart",
      "schema": "schemas/carts_cleanup_expired.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cleanup_expired_carts"
      },
      "ai": {
        "description": "Marks as expired the active carts whose expires_at is in the past (the handler emits cart_checkout.carts.expired)"
      }
    },
    "cart_checkout.checkout.initiate": {
      "permission": "cart_checkout.checkout",
      "schema": "schemas/checkout_initiate.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "initiate_checkout"
      },
      "ai": {
        "description": "Initiates the checkout process, converting the cart into a pending order awaiting payment (the handler emits cart_checkout.checkout.initiated)"
      }
    },
    "cart_checkout.orders.complete": {
      "permission": "cart_checkout.checkout",
      "schema": "schemas/order_complete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_checkout"
      },
      "ai": {
        "description": "Completes the checkout process (paid → completed) and marks the cart as converted (the handler emits cart_checkout.order.completed)"
      }
    },
    "cart_checkout._insert_item": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_insert_item.sql"
      ]
    },
    "cart_checkout._update_item_qty": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_update_item_qty.sql"
      ]
    },
    "cart_checkout._soft_delete_item": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_soft_delete_item.sql"
      ]
    },
    "cart_checkout._soft_delete_cart_items": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_soft_delete_cart_items.sql"
      ]
    },
    "cart_checkout._recalc_totals_by_token": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_recalc_totals_by_token.sql"
      ]
    },
    "cart_checkout._recalc_totals_by_item": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_recalc_totals_by_item.sql"
      ]
    },
    "cart_checkout._expire_carts": {
      "permission": "cart_checkout.manage_cart",
      "sql": [
        "commands/_expire_carts.sql"
      ]
    },
    "cart_checkout._bump_counter": {
      "permission": "cart_checkout.checkout",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "cart_checkout._insert_checkout": {
      "permission": "cart_checkout.checkout",
      "sql": [
        "commands/_insert_checkout.sql"
      ]
    },
    "cart_checkout._complete_checkout": {
      "permission": "cart_checkout.checkout",
      "sql": [
        "commands/_complete_checkout.sql"
      ]
    },
    "cart_checkout._convert_cart": {
      "permission": "cart_checkout.checkout",
      "sql": [
        "commands/_convert_cart.sql"
      ]
    }
  },
  "events": {
    "listen": {},
    "emits": [
      "cart_checkout.cart.abandoned",
      "cart_checkout.cart.cleared",
      "cart_checkout.cart.created",
      "cart_checkout.cart.deleted",
      "cart_checkout.carts.expired",
      "cart_checkout.checkout.initiated",
      "cart_checkout.item.added",
      "cart_checkout.item.removed",
      "cart_checkout.item.updated",
      "cart_checkout.order.completed",
      "cart_checkout.order.failed",
      "cart_checkout.order.paid"
    ]
  },
  "ui": {
    "entry": "dist/cart_checkout.esm.js"
  }
}
