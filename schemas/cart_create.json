{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cart_checkout.carts.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_token"],
  "properties": {
    "session_token": { "type": "string", "minLength": 1, "maxLength": 128 },
    "customer_email": { "type": "string", "default": "", "maxLength": 255 },
    "customer_name": { "type": "string", "default": "", "maxLength": 255 },
    "currency": { "type": "string", "default": "EUR", "minLength": 3, "maxLength": 3 },
    "expires_at": { "type": ["string", "null"], "format": "date-time", "default": null }
  }
}
